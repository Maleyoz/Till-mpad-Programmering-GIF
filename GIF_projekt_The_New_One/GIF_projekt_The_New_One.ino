const int totalGifs = 4; //Glöm inte o öka för varje gif

void setup() {
  pinMode(rightB, INPUT_PULLUP);
  pinMode(leftB, INPUT_PULLUP);

	display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.clearDisplay();
  delay(2000);

}

void loop() {
  bool rightState = digitalRead(rightB);
  bool leftState = digitalRead(leftB);
  
  if (rightState == LOW && lastRightState == HIGH) {
    gifIndex = (gifIndex + 1) % totalGifs;
    frameIndex = 0;
  }

  if (leftState == LOW && lastLeftState == HIGH) {
    gifIndex = (gifIndex - 1 + totalGifs) % totalGifs;
    frameIndex = 0;
  }

	lastRightState = rightState;
  lastLeftState = leftState;


	unsigned long now = millis();
  if (now - lastFrameTime >= frameDelay) {
    lastFrameTime = now;

    display.clearDisplay();
    display.drawBitmap(0, 0, gifs[gifIndex][frameIndex], 128, 64, WHITE);
    display.display();

    frameIndex = (frameIndex + 1) % gifFrameCounts[gifIndex];
  }
	delay(50);
}